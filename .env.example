# Hyperliquid Multi-Agent System Configuration
# Copy this file to .env and fill in your actual values

# Claude API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Selection
ORCHESTRATOR_MODEL=claude-sonnet-4-5-20250929
AGENT_MODEL=claude-haiku-4-5-20250925

# Hyperliquid API Configuration
HYPERLIQUID_MAINNET_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_URL=https://api.hyperliquid-testnet.xyz
HYPERLIQUID_DEFAULT_ENV=mainnet

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=500
RATE_LIMIT_BURST=50

# Memory/Cache Configuration
MEMORY_BASE_PATH=./memories
CACHE_ENABLED=true

# Cache TTL (Time To Live) per data type in seconds
# These override the defaults in core/config.py
# Uncomment and adjust as needed:
#CACHE_TTL_ALL_MIDS=5        # Price data (default: 5s)
#CACHE_TTL_L2_BOOK=3         # Order book (default: 3s)
#CACHE_TTL_META=60           # Meta info (default: 60s)
#CACHE_TTL_CANDLES=300       # Candles (default: 300s)
#CACHE_TTL_USER_STATE=30     # Account state (default: 30s)
#CACHE_TTL_USER_FILLS=10     # Trade fills (default: 10s)
#CACHE_TTL_OPEN_ORDERS=5     # Open orders (default: 5s)
#CACHE_TTL_USER_FUNDING=60   # Funding (default: 60s)
#CACHE_TTL_DEFAULT=30        # Default for other endpoints (default: 30s)

# Agent Pool Configuration
AGENT_POOL_MIN_SIZE=5
AGENT_POOL_MAX_SIZE=50
AGENT_POOL_SCALE_UP_THRESHOLD=100  # requests in queue
AGENT_POOL_SCALE_DOWN_IDLE_SECONDS=300  # 5 minutes

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development/Testing
DEV_MODE=false
USE_TESTNET=false
ENABLE_CACHE=true
